# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: Financial Modeling Prep key for earnings transcripts (Motley Fool is used by default)
FMP_API_KEY=
# SEC asks for a descriptive User-Agent with a contact email
SEC_USER_AGENT=PrologisCapstone research bot your.email@example.com
# Models (defaults shown)
EXTRACT_MODEL=claude-opus-5-5
IMPLICATE_MODEL=claude-opus-5-5
